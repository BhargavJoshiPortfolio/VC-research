---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ConfidenceLegend from '../components/ConfidenceLegend.astro';
import { url } from '../lib/url';

const entry = (await getEntry('pages', 'methodology'))!;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
---

<Base title="Methodology" active="methodology" description={entry.data.description}>
  <p class="eyebrow">Methodology</p>
  <h1>How the companies are found, researched and judged</h1>
  <p class="lede">{entry.data.description}</p>
  <p style="margin-bottom:32px">
    <a class="btn btn-ghost" href={url('/scorecard/')}>See the scorecard and weights</a>
  </p>
  <div class="company-layout">
    <div class="prose">
      <ConfidenceLegend />
      <div style="height:24px" />
      <Content />
    </div>
    <aside class="sidebar">
      <div class="card">
        <p class="eyebrow">On this page</p>
        <ul class="toc">
          {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ul>
      </div>
    </aside>
  </div>
</Base>
